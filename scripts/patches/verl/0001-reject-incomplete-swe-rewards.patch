+class RewardInfrastructureError(RuntimeError):
+    """The SWE verifier did not produce an admissible completed verdict."""
+
+
+def _require_code_verdict(instance: dict, reward: float, extra: dict | None) -> None:
+    if instance.get("dataset_type") != "opensource-code":
+        return
+    extra = extra or {}
+    faults = [key for key in ("error_category", "transport_error", "model_patch_error") if extra.get(key)]
+    returncode = extra.get("verifier_returncode")
+    # Timeout/signal exits and command-not-found are infrastructure failures,
+    # not evidence that a candidate patch failed the executable test suite.
+    completed = type(returncode) is int and 0 <= returncode < 124
+    if faults or not completed:
+        raise RewardInfrastructureError(
+            f"{instance.get('instance_id')}: invalid verifier completion "
+            f"(returncode={returncode!r}, faults={faults})"
+        )
+    expected = 1.0 if returncode == 0 else 0.0
+    if reward != expected or extra.get("resolved") is not (returncode == 0):
+        raise RewardInfrastructureError(
+            f"{instance.get('instance_id')}: verifier result and reward disagree"
+        )
+
