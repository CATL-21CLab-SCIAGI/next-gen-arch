+def _generated_version_paths(pyproject: str) -> list[str]:
+    """Explicit generated Python build metadata, never directory/glob exemptions."""
+    tool = tomllib.loads(pyproject).get("tool", {})
+    hatch = tool.get("hatch", {}).get("build", {}).get("hooks", {}).get("vcs", {})
+    scm = tool.get("setuptools_scm", {})
+    candidates = (hatch.get("version-file"), scm.get("write_to"), scm.get("version_file"))
+    return [path for path in candidates if isinstance(path, str)
+            and re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", path)
+            and not any(part in (".", "..") for part in path.split("/"))]
 
 
