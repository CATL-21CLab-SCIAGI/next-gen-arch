+    def _restore_generated_versions(self) -> None:
+        """Restore original build metadata; policy edits are not submitted source."""
+        for path, (canonical, content) in self._generated_version_snapshots.items():
+            current = self.env.execute(f"realpath -m -- {shlex.quote(path)}", cwd=self.repo_path, timeout=10)
+            if current.get("returncode") != 0 or current["output"].strip() != canonical:
+                raise RuntimeError("Generated version path changed during rollout")
+            with tempfile.NamedTemporaryFile(mode="wb") as snapshot:
+                snapshot.write(content)
+                snapshot.flush()
+                self.env.copy_to(snapshot.name, canonical)
