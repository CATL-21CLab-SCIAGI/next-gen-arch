+def repair_mxfp8_model_params_from_optimizer(model, optimizer, *, reason: str) -> None:
+    """Rebuild MXFP8 compute weights from the distributed optimizer's FP32 masters.
+
+    NeMo 26.06 / Transformer Engine 2.14 can serialize non-finite BF16 model
+    tensors when MXFP8 parameter gather reuses the gradient buffer. The
+    distributed optimizer checkpoint remains finite. Re-stage its FP32 master
+    shards and synchronously all-gather them so TE re-quantizes valid compute
+    weights after a load and after each checkpoint save.
+    """
+    if os.environ.get("NGA_REPAIR_MXFP8_FROM_OPTIMIZER") != "1":
+        return
+
+    args = get_args()
+    assert args.fp8_param_gather
+    assert args.reuse_grad_buf_for_mxfp8_param_ag
+    assert optimizer is not None
+
+    repaired_optimizers = 0
+    torch.distributed.barrier()
+    with torch.no_grad():
+        for optim_instance in optimizer.chained_optimizers:
+            if not isinstance(optim_instance, DistributedOptimizer):
+                continue
+            optim_instance._copy_main_params_to_param_buffer()
+            repaired_optimizers += 1
+
+        assert repaired_optimizers > 0
+        for model_chunk in model:
+            assert isinstance(model_chunk, DDP)
+            model_chunk.start_param_sync(force_sync=True, force_dispatch=True)
+        torch.cuda.synchronize()
+    torch.distributed.barrier()
+    print_rank_0(
+        f"Rebuilt MXFP8 model parameters from FP32 optimizer masters after {reason}."
+    )
+
+
 # Only report memory for first 3 checkpoint saves.
 num_checkpoints_memory_reported = 0
 MAX_NUM_CHECKPOINTS_MEMORY_REPORTED = 3
