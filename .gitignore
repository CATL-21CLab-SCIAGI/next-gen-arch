# Publication boundary: new top-level workspaces are local unless admitted here.
/*
!/.github/
!/.gitignore
!/.python-version
!/AGENTS.md
!/CITATION.cff
!/LICENSE
!/README.md
!/pyproject.toml
!/uv.lock
!/src/
!/tests/
!/recipes/
!/scripts/
!/docs/

# Python, build, editor and experiment output (also inside admitted directories).
.DS_Store
*.egg-info/
*.py[cod]
__pycache__/
.coverage*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
dist/
build/
wandb/
mlruns/
.ipynb_checkpoints/
*.log
*.prof
*.nsys-rep
*.ncu-rep
*.pt
*.pth
*.safetensors
*.ckpt
*.bin
*.idx
*.parquet
*.arrow
*.jsonl
*.jsonl.gz
*.npy
*.npz
*.pickle
*.pkl

# Secrets and local overrides. Never use force-add for runtime receipts.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

